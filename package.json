{
  "name": "darukaa-earth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Geospatial Carbon & Biodiversity Analytics Platform",
  "scripts": {
    "prepare": "husky",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "ruff check backend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "pytest backend/tests",
    "test": "npm run test:backend && npm run test:frontend",
    "format:frontend": "npm --prefix frontend run format",
    "format:backend": "black backend",
    "format": "npm run format:frontend && npm run format:backend",
    "build:frontend": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.9.8"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx,css}": [
      "npx prettier --write"
    ],
    "backend/**/*.py": [
      ".\\backend\\.venv\\Scripts\\black",
      ".\\backend\\.venv\\Scripts\\ruff check --fix"
    ]
  }
}
