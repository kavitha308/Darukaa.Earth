PROJECT_NAME="Darukaa.Earth Backend"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-development-key-change-in-production-darukaa-earth-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL + PostGIS in production, SQLite fallback for unit testing)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/darukaa_earth"

# CORS origins (comma-separated list)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4173"

# Admin default credentials for automatic initial seed
FIRST_SUPERUSER_EMAIL="admin@darukaa.earth"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"
FIRST_SUPERUSER_NAME="Darukaa Admin"
